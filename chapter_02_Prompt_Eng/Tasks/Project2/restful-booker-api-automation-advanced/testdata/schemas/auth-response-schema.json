{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "POST /auth — Success Response",
  "type": "object",
  "required": ["token"],
  "additionalProperties": false,
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "description": "Session token returned on successful authentication"
    }
  }
}
