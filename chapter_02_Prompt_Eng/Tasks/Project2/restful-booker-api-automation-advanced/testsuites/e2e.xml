<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  E2E suite: single-threaded to preserve test ordering within the flow.
  Priority annotations on each test method control execution sequence.
-->
<suite name="E2E Suite" verbose="1" parallel="none">

    <listeners>
        <listener class-name="com.restfulbooker.api.listeners.ExtentTestNGListener"/>
    </listeners>

    <test name="E2E — Full Booking Lifecycle" preserve-order="true">
        <groups>
            <run>
                <include name="e2e"/>
            </run>
        </groups>
        <classes>
            <class name="com.restfulbooker.api.tests.e2e.E2EBookingFlowTests"/>
        </classes>
    </test>

</suite>
