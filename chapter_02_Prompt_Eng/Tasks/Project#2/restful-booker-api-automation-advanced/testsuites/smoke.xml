<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Suite" verbose="1" parallel="methods" thread-count="2">

    <listeners>
        <listener class-name="com.restfulbooker.api.listeners.ExtentTestNGListener"/>
        <listener class-name="com.restfulbooker.api.listeners.RetryListener"/>
    </listeners>

    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.restfulbooker.api.tests.smoke.PingTests"/>
            <class name="com.restfulbooker.api.tests.smoke.AuthSmokeTests"/>
        </classes>
    </test>

</suite>
